# Production Host (used by finagent_api.py)
PRODUCTION_HOST=62.146.234.147

# Shared Backup Configuration
LLM_BACKUP_MODEL=xiaomi/mimo-v2.6-flash
LLM_BACKUP_URL=https://zenmux.ai/api/v1

# Step 6: Fund Holdings
FUND_HOLDING_MODEL=sapiens-ai/agnes-2.5-flash
FUND_HOLDING_URL=https://zenmux.ai/api/v1

# Step 8.1: Bull Analysis
BULL_MODEL=xiaomi/mimo-v2.6-flash
BULL_URL=https://zenmux.ai/api/v1

# Step 8.2: Bear Analysis
BEAR_MODEL=minimax/minimax-h3
BEAR_PROVIDER=minimax
BEAR_URL=https://zenmux.ai/api/v1

# Step 8.3: Research Debate
DEBATE_MODEL=openai/gpt-6-luna
DEBATE_PROVIDER=azure
DEBATE_URL=https://zenmux.ai/api/v1

# Step 9: Trading Plan
TRADING_MODEL=openai/gpt-6-luna
TRADING_PROVIDER=azure
TRADING_URL=https://zenmux.ai/api/v1

# Step 10: Lesson Summary
LESSON_MODEL=sapiens-ai/agnes-2.5-flash
LESSON_URL=https://zenmux.ai/api/v1

EMBEDDING_MODEL_NAME=openai/text-embedding-3-small
RESULT_DIR=./results
QDRANT_HOST=localhost
QDRANT_PORT=6333
UVICORN_PORT=8001
SKIP_RISK_MANAGEMENT=true
# API Keys are provided via environment variables:
# ZENMUX_API_KEY (required) - for https://zenmux* URLs
# AGNES_API_KEY (optional) - for https://apihub.agnes-ai* URLs
# NVIDIA_API_KEY (optional) - for https://integrate.api.nvidia* URLs
# DEEPSEEK_API_KEY (optional) - for https://api.deepseek* URLs
# BIGMODEL_API_KEY (optional) - for https://open.bigmodel* URLs
